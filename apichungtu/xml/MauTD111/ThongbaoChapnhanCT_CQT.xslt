<?xml version="1.0" encoding="utf-8" ?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:ex="http://exslt.org/dates-and-times"
                xmlns:fn="http://www.w3.org/2005/02/xpath-functions"
                xmlns:inv="http://laphoadon.gdt.gov.vn/2014/09/invoicexml/v1" extension-element-prefixes="ex">
    <xsl:output method="html" />
    <xsl:template match="TDiep">
        <html lang="en"
            xmlns="http://www.w3.org/1999/xhtml">
            <head>
                <meta charset="UTF-8"/>
                <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Document</title>
                <style type="text/css">
                .table1
                {
                    width:100%;
                        text-align:center;
                    line-height: 2;	
                        padding-left:20px;
                }
                .table2{
                    width:100%;
            padding-left:40px;
            padding-right:40px;
            line-height: 2;
            
       }
        .table3{
                    width:100%;
            border: 1px solid black;
  border-collapse: collapse;
   padding-left:20px;
            
       }
       
     
          @page {
                size: A4;
                margin: 0;
                
              }
              @media print {
                html, body {
                  width: 210mm;
                  height: 297mm;
                      zoom: 98%;
                  center;
                }
              }                                          
    </style>
            </head>
            <page size="A4">
                <body>
                    <div style="font-family: Times New Roman;border:5px double brown;  background-repeat: no-repeat; width:210mm; height: 297mm;z-index:1; font-size:12pt;padding:40px;background-image: url(data:image/jpeg;base64,); background-position: center; z-index:1; background-size:200%;background-color: hsla(0,0%,100%,0.90);	">
                        <table style="width:100%;" class="table1">
                            <tr>
                                <td style="text-align:right;">     </td>
                                <td style="text-align:right;">      Mẫu số:
                                    <xsl:value-of select="DLieu/TBao/DLTBao/MSo "/>
                                </td>
                            </tr>
                            <tr>
                                <td  width="40%" style="text-transform: uppercase;">
                                    <xsl:value-of select="DLieu/TBao/DLTBao/TCQTCTren "/>
                                    <br/>
                                    <span style="font-weight:bold;">
                                        <xsl:value-of select="DLieu/TBao/DLTBao/TCQT "/>
                                    </span>
                                    <br/>
                                    <hr width="50%"/>
                                </td>
                                <td style="font-weight:bold;text-transform: uppercase;">  CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM
                                    <br/>Độc lập - Tự do - Hạnh phúc
                                    <br/>
                                    <hr width="50%"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Số:
                                    <xsl:value-of select="DLieu/TBao/STBao/So "/>
                                    <xsl:value-of select="DLieu/TBao/DLTBao/So "/>
                                </td>
                                <td>
                                    <i>
                                        <xsl:value-of select="DLieu/TBao/DLTBao/DDanh "/>, Ngày
                                        <xsl:value-of select="substring( //*[local-name() = 'SigningTime'],9,2)" />
                                        
                                        tháng
                                        <xsl:value-of select="substring( //*[local-name() = 'SigningTime'],6,2)" />
                                        
                                        năm
                                        <xsl:value-of select="substring( //*[local-name() = 'SigningTime'],1,4)" />
                                    </i>
                                </td>
                            </tr>
                        </table>
                        <table style="width:100%;" class="table1">
                            <tr>
                                <td style="font-weight:bold; font-size:15pt; text-transform: uppercase;">
                                    <b>THÔNG BÁO</b>
                                </td>
                            </tr>
                            <tr>
                                <td style="	">
                                    <xsl:choose>
                                        <xsl:when test="contains(.,'báo')">
                                            <b>
                                                <xsl:value-of select=" substring-after(DLieu/TBao/DLTBao/Ten,'báo')" />
                                            </b>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <b>
                                                <xsl:value-of select="DLieu/TBao/DLTBao/Ten" />
                                            </b>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </td>
                            </tr>
                            <tr>
                                <td style="">
                                    Kính gửi:
                                    <xsl:value-of select="DLieu/TBao/DLTBao/TNNT "/>  (MST:
                                    <xsl:value-of select="DLieu/TBao/DLTBao/MST "/>)
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <xsl:choose>
                            <xsl:when test="DLieu/TBao/DLTBao/TTXNCQT!=2">
                                <table class="table2">
                                    <tr>
                                        <td style="text-align: justify">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Sau khi xem xét tờ khai đăng ký sử dụng chứng từ điện tử điện tử ngày
                                            <xsl:value-of select="substring( //*[local-name() = 'Ngay'],9,2)" />
                                            
                                    
                                   /
                                            <xsl:value-of select="substring( //*[local-name() = 'Ngay'],6,2)" />
                                            
/
                                            <xsl:value-of select="substring( //*[local-name() = 'Ngay'],1,4)" />
                                            <br/>
                                        &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Cơ quan thuế thông báo chấp nhận đề nghị đăng ký sử dụng hóa đơn điện tử của đơn vị. (Mã hồ sơ thủ tục hành chính:
                                            <xsl:value-of select="DLieu/TBao/DLTBao/MHSo "/>)
                                            <br/>

                           &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Tài khoản sử dụng dịch vụ chứng từ điện tử được gửi đến hộp thư điện tử/điện thoại liên hệ của người nộp thuế, đề nghị người nộp thuế thực hiện khai báo các thông tin liên quan theo nội dung hướng dẫn của cơ quan thuế tại thư điện tử này.
                                            <!-- <br/>
                         &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Trường hợp người nộp thuế đăng ký sử dụng hóa đơn điện tử có mã không trả tiền dịch vụ theo quy định tại khoản 1 Điều 14 Nghị định số 123/2020/NĐ-CP, cơ quan thuế thông báo người nộp thuế đăng ký giao dịch sử dụng hóa đơn điện tử miễn phí qua tổ chức cung cấp dịch vụ hóa đơn điện tử. Thông tin tổ chức cung cấp dịch vụ hóa đơn điện tử do Tổng cục Thuế ủy thác tại Cổng thông tin điện tử của Tổng cục Thuế -->
                                            <xsl:if test="DLieu/TBao/DLTBao/MCCQT!=''">
                                                <br/>
                         &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Chuỗi năm ký tự duy nhất cơ quan thuế cấp là:
                                                <xsl:value-of select="DLieu/TBao/DLTBao/MCCQT "/>
                                            </xsl:if>
                                            <xsl:if test="DLieu/TBao/DLTBao/MCCQT!=''">
                                                <br/>
                         &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Quy tắc Mã của cơ quan thuế trên hóa đơn điện tử khởi tạo từ máy tính tiền là dải ký tự bao gồm 23 ký tự có cấu trúc như sau: C
                                                <sub>1</sub>C
                                                <sub>2</sub>-C
                                                <sub>3</sub>C
                                                <sub>4</sub>-ZAMJZ-C
                                                <sub>10</sub>C
                                                <sub>11</sub>C
                                                <sub>12</sub>C
                                                <sub>13</sub>C
                                                <sub>14</sub> C
                                                <sub>15</sub>C
                                                <sub>16</sub> C
                                                <sub>17</sub>C
                                                <sub>18</sub> C
                                                <sub>19</sub>  C
                                                <sub>20</sub>
                                            </xsl:if>
                                            <br/>
                         &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Cơ quan thuế thông báo để người nộp thuế biết, thực hiện./.
                                        </td>
                                    </tr>
                                </table>
                            </xsl:when>
                            <xsl:otherwise>
                                <table class="table2">
                                    <tr>
                                        <td style="text-align: justify">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Sau khi xem xét tờ khai đăng ký sử dụng chứng từ điện tử điện tử ngày
                                            <xsl:value-of select="substring( DLieu/TBao/DLTBao/TGGui,9,2)" />
                                    
                                   /
                                            <xsl:value-of select="substring( DLieu/TBao/DLTBao/TGGui,6,2)" />
/
                                            <xsl:value-of select="substring( DLieu/TBao/DLTBao/TGGui,1,4)" />
                                            <br/>
                                        &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Cơ quan thuế thông báo không chấp nhận đề nghị đăng ký sử dụng chứng từ điện tử của đơn vị.
                                            <br/>

                                           &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Cơ quan thuế không chấp nhận người nộp thuế thay đổi thông tin sử dụng chứng từ điện tử. Lý do:
                                            <br/>
                                        </td>
                                    </tr>
                                </table>
                                <table style="width:100%;text-align:center; border: 1px solid black;" border='2 '>
                                    <tr>
                                        <td>
                                            <b>STT</b>
                                        </td>
                                        <td>
                                            <b>Tiêu chí lỗi</b>
                                        </td>
                                        <td>
                                            <b>Lý do không chấp nhận </b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>(1)</td>
                                        <td>(2)</td>
                                        <td> (3) </td>
                                    </tr>
                                    <xsl:for-each select="DLieu/TBao/DLTBao/DSLDKCNhan/LDo">
                                        <tr>
                                            <td>1</td>
                                            <td>Phương thức chuyển dữ liệu</td>
                                            <td style="text-align:left;">
                                                <xsl:value-of select="MTa" />
                                                <xsl:value-of select="DLTBao/DSLDKCNhan/LDo/MTa" />
                                            </td>
                                        </tr>
                                    </xsl:for-each>
                                    <!-- <xsl:for-each select="DLieu/TBao/DLTBao/DSLDKCNhan/LDo/DLTBao/DSLDKCNhan/LDo">
                                           <tr><td>1</td><td>Phương thức chuyển dữ liệu</td><td style="text-align:left;">   <xsl:value-of select="MTa" /></td></tr>
                                          
                                        </xsl:for-each> -->
                                </table>
                                <table class="table2">
                                    <tr>
                                        <td style="text-align: justify">

                                          
                          &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Cơ quan thuế thông báo để người nộp thuế biết, thực hiện./.
                                        </td>
                                    </tr>
                                </table>
                            </xsl:otherwise>
                        </xsl:choose>
                        <table class="table2">
                            <tr>
                                <td ></td>
                                <td style="height:120px;width: 40%;color:green">
                                    <div style="paramSign;background-image:url(data:image/jpeg;base64,); background-repeat:no-repeat;background-position: left; background-size: contain;height:auto; border: 1px solid green; text-align:left;padding-top:5px; ">
                                        Signature Valid:
                                        <br/>
                                        <!-- <xsl:value-of select="DLieu/TBao/DLTBao/TCQTCTren "/> -->
                                      Ký bởi:
                                        <xsl:value-of select="substring-before( substring-after(//*[local-name() = 'X509SubjectName'],'CN='), ',')" />
                                        <br/>  Ký ngày:
                                        <xsl:variable name="date" select="normalize-space((//*[local-name()='SigningTime'])[1])"/>
                                        <xsl:value-of select="$date"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </body>
            </page>
        </html>
    </xsl:template>
</xsl:stylesheet>